# Pinned uv release; Dependabot keeps it up to date.
FROM ghcr.io/astral-sh/uv:0.13.8 AS uv

FROM python:3.12-alpine AS base
WORKDIR /app
RUN apk add gcc musl-dev
# Keep the virtual environment outside /app and use the image's own Python.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV UV_PYTHON_DOWNLOADS=never
ENV PATH="/opt/venv/bin:$PATH"

FROM base AS installer
ENV DJANGO_SETTINGS_MODULE=backend.app.settings_development
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-cache
COPY ./backend ./backend
COPY ./manage.py .
RUN mkdir ./static ./media
RUN python3 manage.py collectstatic --noinput

FROM base AS runner
COPY --from=installer /opt/venv /opt/venv
COPY --from=installer /app/backend /app/backend
COPY --from=installer /app/manage.py .
COPY --from=installer /app/static /app/static
COPY --from=installer /app/media /app/media

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=backend.app.settings_development

ENTRYPOINT ["uvicorn", "backend.app.asgi:application", "--host", "0.0.0.0", "--port", "8000", "--reload"]
